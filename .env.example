# Postgres holding the `acme` schema (the shared Neon DB). Run db/schema.sql once.
ACME_DATABASE_URL=
# Stripe TEST MODE secret key (sk_test_...). Without it, checkout uses a mock with the same outcomes.
STRIPE_SECRET_KEY=
# Whydunit engine base URL, used by the /api/wd proxy. Without it, snippet uploads are dropped.
WHYDUNIT_ENGINE_URL=
# Project ingest key for the snippet (public by design).
NEXT_PUBLIC_WHYDUNIT_KEY=
# Share of sessions recorded with rrweb (0..1).
NEXT_PUBLIC_WHYDUNIT_REPLAY_RATE=0.2
